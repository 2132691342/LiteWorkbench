<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liteworkbench.mapper.WbKbDocMapper">

    <sql id="Page_Condition">
        <where>
            deleted = false
            AND user_id = #{userId}
            AND kb_id = #{kbId}
            <if test="keyword != null and keyword != ''">
                AND doc_name LIKE '%' || #{keyword} || '%'
            </if>
            <if test="state != null and state != ''">
                AND state = #{state}
            </if>
        </where>
    </sql>

    <select id="selectPage" resultType="com.liteworkbench.domain.entity.WbKbDocDO">
        SELECT * FROM wb_kb_doc
        <include refid="Page_Condition"/>
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT count(*) FROM wb_kb_doc
        <include refid="Page_Condition"/>
    </select>
</mapper>
