<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liteworkbench.mapper.WbMemoryMapper">

    <sql id="Page_Condition">
        <where>
            deleted = false
            AND user_id = #{userId}
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="req.keyword != null and req.keyword != ''">
                AND (memory_key ILIKE '%' || #{req.keyword} || '%'
                     OR memory_value ILIKE '%' || #{req.keyword} || '%')
            </if>
        </where>
    </sql>

    <select id="selectPage" resultType="com.liteworkbench.domain.entity.WbMemoryDO">
        SELECT * FROM wb_memory
        <include refid="Page_Condition"/>
        ORDER BY weight DESC, updated_at DESC NULLS LAST, created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT count(*) FROM wb_memory
        <include refid="Page_Condition"/>
    </select>
</mapper>
