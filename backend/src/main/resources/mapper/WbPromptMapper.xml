<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liteworkbench.mapper.WbPromptMapper">

    <sql id="Page_Condition">
        <where>
            deleted = false
            AND (user_id = #{userId} OR builtin = true)
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="req.keyword != null and req.keyword != ''">
                AND (prompt_title LIKE '%' || #{req.keyword} || '%'
                     OR content LIKE '%' || #{req.keyword} || '%')
            </if>
        </where>
    </sql>

    <select id="selectPage" resultType="com.liteworkbench.domain.entity.WbPromptDO">
        SELECT * FROM wb_prompt
        <include refid="Page_Condition"/>
        ORDER BY builtin DESC, use_count DESC, created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT count(*) FROM wb_prompt
        <include refid="Page_Condition"/>
    </select>
</mapper>
