# 构建上下文裁剪：缺了它会把 node_modules（Windows 二进制）与 target 送进上下文，
# 并让 `COPY frontend .` 把宿主 node_modules 拷进 Linux 镜像导致 node 跑不起来。
.git/
.github/
.shots/
.secrets/

backend/target/
backend/data/
backend/logs/

frontend/node_modules/
frontend/dist/
frontend/.vite/

logs/
*.log

# 机密不入镜像层
deploy/.env.infra
deploy/.env.app
.env
