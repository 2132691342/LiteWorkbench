# 部署机密的字段清单：gen-secrets.sh 逐行读取本文件生成 .env.infra，新增字段只需改这里。
# 应用编排与中间件编排必须共用同一份 .env.infra，两侧口令不一致会直接连不上。
LITEWORKBENCH_DATASOURCE_PASSWORD=
LITEWORKBENCH_REDIS_PASSWORD=
# 固定用户名：MQ 的账号在容器首次初始化时建立，改动需重建数据卷
LITEWORKBENCH_MQ_USERNAME=admin
LITEWORKBENCH_MQ_PASSWORD=
# MinIO 账号前缀固定，便于在控制台区分；其余部分随机
LITEWORKBENCH_STORAGE_ACCESS_KEY=
LITEWORKBENCH_STORAGE_SECRET_KEY=
# Sa-Token 等签名密钥：长度不足会在启动期直接失败
LITEWORKBENCH_SECURITY_SECRET=
# 留空即由应用随机生成并仅在启动日志 WARN 打印一次；填值则只对未激活的种子账号生效
LITEWORKBENCH_ADMIN_PASSWORD=
